# Only VITE_* variables reach the browser, and everything in them is public. Never put secrets here.
# Public base of short links (the API's own URL). Shown in the UI and used for the live stream.
VITE_SHORT_BASE_URL=http://localhost:4000
# Keep /api so the session cookie stays same-origin (Vite proxy locally, Vercel rewrite in production).
VITE_API_BASE=/api
