# Copy to .env and fill in. Never commit real values.
PORT=4000
NODE_ENV=development
# Local: docker compose (see root docker-compose.yml).
# Neon (production): the POOLED string (host has -pooler) with &pgbouncer=true&connect_timeout=15 added.
DATABASE_URL=postgresql://linkpulse:linkpulse_local_only@localhost:5433/linkpulse
# Direct (non-pooled) URL, used only by Prisma migrations. Locally the same as DATABASE_URL.
DIRECT_URL=postgresql://linkpulse:linkpulse_local_only@localhost:5433/linkpulse
# Leave empty to run without Redis (no cache, clicks written straight to Postgres).
# Upstash: rediss://default:<password>@<host>:6379 (TLS). Redis Cloud: redis://default:<password>@<host>:<port>.
REDIS_URL=redis://localhost:6380
JWT_SECRET=change-me-to-a-long-random-string
HASH_SALT=change-me-to-another-long-random-string
# Public base of short links and QR codes (the API's own public URL).
SHORT_BASE_URL=http://localhost:4000
# The web app origin (used for CORS on /stream and for the redirect-loop check).
# Comma-separated list allowed (e.g. production + Vercel preview URL); the first one is the main one.
WEB_ORIGIN=http://localhost:5173
# Run the click worker + alerts job inside the API process.
RUN_WORKER=true
TZ_DISPLAY=Asia/Kolkata
# Proxies in front of the API (Render = 1).
TRUST_PROXY_HOPS=1
# false = skip the offline IP→city lookup (saves memory on small hosts).
GEOIP_ENABLED=true
# Password for the seeded demo users (admin@/team@/other@linkpulse.test).
SEED_PASSWORD=change-me
